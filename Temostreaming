<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TEMOMODSTREAMING - Gana Seguidores TikTok</title>
<style>
body { background:#0a0a0a; color:white; font-family:Arial; margin:0; padding-bottom:20px; }
header { background:#000; padding:15px; text-align:center; font-size:26px; font-weight:bold; border-bottom:2px solid #ff0050; }
header span { color:#ff0050; }
.sub { text-align:center; padding:10px; color:#ccc; font-size:14px; }
.form { background:#1a1a1a; margin:15px; padding:15px; border-radius:12px; border:1px solid #333; }
input { width:100%; padding:12px; margin:8px 0; border-radius:8px; border:none; background:#2a2a2a; color:white; font-size:16px; box-sizing:border-box; }
.btn-red { background:#ff0050; color:white; padding:13px; width:100%; border:none; border-radius:8px; font-weight:bold; font-size:16px; }
.card { background:#1a1a1a; margin:15px; padding:15px; border-radius:12px; border:1px solid #333; display:flex; align-items:center; justify-content:space-between; }
.card b { font-size:17px; }
.card small { color:#aaa; }
.btn-seguir { background:#25F4EE; color:black; padding:10px 15px; border-radius:8px; text-decoration:none; font-weight:bold; }
</style>
</head>
<body>
<header>TEMO<span>MOD</span>STREAMING</header>
<p class="sub">🔥 Sigue a 3 personas y los demás te seguirán a ti<br>Comunidad de TikTok - 100% Real</p>

<div class="form">
  <h3 style="margin:0">🚀 Únete y gana seguidores</h3>
  <input id="usuario" placeholder="@ tu usuario de TikTok sin @">
  <input id="nombre" placeholder="Tu nombre o apodo">
  <button class="btn-red" onclick="agregar()">UNIRME AHORA</button>
</div>

<div id="lista"></div>

<script>
let usuarios = JSON.parse(localStorage.getItem('temo_users') || '[]');
if(usuarios.length==0){
  usuarios = [
    {user:'temomodstreaming', nombre:'TEMO - ADMIN'},
    {user:'ejemplo1', nombre:'Gamer Pro'},
    {user:'ejemplo2', nombre:'Free Fire Girl'},
  ];
}
function mostrar(){
  let html = '';
  usuarios.slice().reverse().forEach(u=>{
    html += `<div class="card"><div><b>@${u.user}</b><br><small>${u.nombre} • TikTok</small></div><a class="btn-seguir" target="_blank" href="https://www.tiktok.com/@${u.user}">SEGUIR +</a></div>`;
  });
  document.getElementById('lista').innerHTML = html;
}
function agregar(){
  let user = document.getElementById('usuario').value.trim().replace('@','');
  let nombre = document.getElementById('nombre').value.trim();
  if(!user || !nombre){ alert('Pon tu usuario y tu nombre bro'); return; }
  usuarios.push({user:user, nombre:nombre});
  localStorage.setItem('temo_users', JSON.stringify(usuarios));
  mostrar();
  alert('Listo bro! Ya estás en la lista, ahora sigue a los demás para que te sigan');
  document.getElementById('usuario').value='';
  document.getElementById('nombre').value='';
}
mostrar();
</script>
</body>
</html>
